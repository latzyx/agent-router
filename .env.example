# lazy-agent-router 生产推理参考配置
# 复制为 .env 后按部署机器调整：cp .env.example .env

# auto 会优先使用可用的 CUDA；生产 GPU 实例建议明确设置为 cuda。
LAZY_AGENT_ROUTER_DEVICE=cuda

# 启动期间加载并预热指定模型。模型目录必须位于 models/ 下。
# CPU 开发环境或尚未下载模型时可将此项留空。
LAZY_ROUTER_PRELOAD_MODEL=lazy-agent-router-macbert-v22

# 约 1000 QPS 的吞吐优先配置；低流量、延迟优先场景可改为 32。
LAZY_ROUTER_MAX_BATCH_SIZE=64

# 收集并发请求形成一个 GPU batch 的最长等待时间（毫秒）。
LAZY_ROUTER_MAX_WAIT_MS=3

# 有界队列用于背压；达到上限时 API 返回 HTTP 429。
LAZY_ROUTER_QUEUE_SIZE=4096

# 包含排队与模型推理的单请求超时时间（毫秒）；超时返回 HTTP 504。
LAZY_ROUTER_REQUEST_TIMEOUT_MS=500
